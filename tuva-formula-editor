  {l:'cos',v:'cos(',d:'Cosine (radians).',s:'cos(angle)',e:'cos(0) → 1'},
  {l:'tan',v:'tan(',d:'Tangent (radians).',s:'tan(angle)',e:'tan(π ÷ 4) → 1'},
  {l:'date',v:'date(',d:'Create a date.',s:'date(value)',e:'date("2024-01-15")'},
  {l:'secondsToMS',v:'secondsToMS(',d:'Seconds to ms.',s:'secondsToMS(s)',e:'secondsToMS(60) → 60000'},
  {l:'minutesToMS',v:'minutesToMS(',d:'Minutes to ms.',s:'minutesToMS(m)',e:'minutesToMS(5)'},
  {l:'hoursToMS',v:'hoursToMS(',d:'Hours to ms.',s:'hoursToMS(h)',e:'hoursToMS(2)'},
  {l:'daysToMS',v:'daysToMS(',d:'Days to ms.',s:'daysToMS(d)',e:'daysToMS(7)'},
  {l:'weeksToMS',v:'weeksToMS(',d:'Weeks to ms.',s:'weeksToMS(w)',e:'weeksToMS(4)'},
