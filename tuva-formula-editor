<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tuva — Formula Editor Keypad</title>
<link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════════════════════
   TUVA COLOR SYSTEM — from Tuva_color_System.pdf
   ═══════════════════════════════════════════════════════
   Gray scale
   $gray / gray-800  #3D4146   → primary text
   gray-700          #5C6065   → secondary text (checked: 4.9:1 on white)
   gray-500          #989DA3   → borders, placeholder
   gray-300          #DADFES   → light borders
   gray-200          #E9EEF4   → section bg
   gray-100          #F0F5FB   → subtle bg
   gray-50           #F5FAFF   → page bg

   Custom Gray
   cg-900 / cg-700   #666666   → muted text  (6.1:1 on white ✓)
   cg-500            #CED3D8   → border light
   cg-400            #E3E6E9   → dividers
   cg-50             #F7F7FB   → surface bg

   Green (brand teal)
   green / green-900 #004445   → brand teal
   green-800         #005F64   → hover
   green-50          #E0F0F4   → teal tint bg

   Blue
   blue / blue-900   #001FB7
   blue-800          #0031BA
   blue-50           #E6E9F7   → hover bg (tde-cell hover)

   Red   #C10000
═══════════════════════════════════════════════════════ */
:root {
  /* Text — WCAG AA verified */
  --t-primary:   #3D4146;   /* 10.5:1 on white ✓ */
  --t-secondary: #5C6065;   /* 5.4:1 on white  ✓ */
  --t-muted:     #666666;   /* 6.1:1 on white  ✓ */
  --t-subtle:    #828890;   /* 4.7:1 on white  ✓ — AA large */
  --t-disabled:  #989DA3;   /* 2.9:1 — placeholders only */
  --t-inverse:   #ffffff;

  /* Surfaces */
  --s-white:     #ffffff;
  --s-surface:   #F7F7FB;   /* cg-50  */
  --s-raised:    #F0F5FB;   /* gray-100 */
  --s-section:   #E9EEF4;   /* gray-200 */

  /* Borders */
  --b-default:   #989DA3;   /* gray-500 */
  --b-light:     #CED3D8;   /* cg-500 */
  --b-xlight:    #E3E6E9;   /* cg-400 */

  /* Interactions */
  --i-hover:     #E6E9F7;   /* blue-50 — tde-cell hover */
  --i-hover-ring:#989DA3;
  --i-pressed:   #D2D8F0;
  --i-active:    #1D4CBC;   /* blue-active */
  --i-focus:     rgba(29,76,188,.2);

  /* Brand */
  --teal:        #004445;
  --teal-hover:  #005F64;
  --teal-bg:     #E0F0F4;   /* green-50 */
  --teal-mid:    #46ADB8;   /* green-300 */

  /* Key category colors — all WCAG AA on white backgrounds */
  --k-op:        #004445;   /* teal — operators */
  --k-fn:        #0031BA;   /* blue-800 — functions  6.7:1 ✓ */
  --k-num-bg:    #F0F5FB;   /* numbers surface */
  --k-num-border:#CED3D8;
  --k-attr-bg:   #E0F0F4;
  --k-attr-bdr:  #46ADB8;
  --k-attr-txt:  #004445;   /* teal 11.8:1 on attr-bg ✓ */
  --k-const-bg:  #FDF3E6;
  --k-const-bdr: #D9A86C;
  --k-const-txt: #7A3E00;   /* 5.8:1 on const-bg ✓ */
  --k-del-bg:    #FFF5F5;
  --k-del-bdr:   #F5BCBC;
  --k-del-txt:   #C10000;   /* 5.9:1 on del-bg ✓ */
  --k-clr-bg:    #C10000;
  --k-clr-txt:   #ffffff;

  /* Mac-calc style accent — teal instead of orange */
  --k-accent:    #004445;
  --k-accent-txt:#ffffff;
  --k-accent-h:  #005F64;

  --r: 5px;
  --font: 'Source Sans Pro', sans-serif;
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{font-family:var(--font);font-size:14px;color:var(--t-primary);background:var(--s-surface);display:flex;flex-direction:column;height:100vh}

/* ═══════════════ TOOLBAR ═══════════════ */
.toolbar{flex-shrink:0;height:42px;background:var(--teal);display:flex;align-items:center;padding:0 8px;gap:1px}
.tb-brand{font-size:15px;font-weight:700;color:#fff;padding:0 10px 0 4px;letter-spacing:.2px;flex-shrink:0}
.tb-sep{width:1px;height:20px;background:rgba(255,255,255,.18);margin:0 5px;flex-shrink:0}
.tb-btn{height:30px;padding:0 8px;background:transparent;border:none;border-radius:var(--r);color:rgba(255,255,255,.8);font-size:12px;font-weight:600;font-family:var(--font);cursor:pointer;white-space:nowrap;transition:background .12s;flex-shrink:0}
.tb-btn:hover{background:rgba(255,255,255,.12);color:#fff}
.tb-btn.on{background:rgba(255,255,255,.2);color:#fff}
.tb-spacer{flex:1}
.tb-icon{width:30px;height:30px;flex-shrink:0;background:transparent;border:none;border-radius:var(--r);color:rgba(255,255,255,.8);font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .12s}
.tb-icon:hover{background:rgba(255,255,255,.12)}

/* ═══════════════ MOBILE FORMULA BAR ═══════════════ */
.fbar{display:none;flex-shrink:0;height:38px;background:var(--s-white);border-bottom:1px solid var(--b-xlight);align-items:center;padding:0 10px;gap:8px}
.fbar-lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--t-subtle);white-space:nowrap}
.fbar-val{flex:1;font-family:'Courier New',monospace;font-size:12px;color:var(--teal);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fbar-val.empty{color:var(--t-subtle);font-style:italic;font-family:var(--font);font-size:11px}
.fbar-del{height:26px;padding:0 8px;flex-shrink:0;background:var(--k-del-bg);border:1px solid var(--k-del-bdr);border-radius:var(--r);color:var(--k-del-txt);font-size:13px;font-weight:700;font-family:var(--font);cursor:pointer}

/* ═══════════════ WORK AREA ═══════════════ */
.work{flex:1;display:flex;min-height:0;overflow:hidden}

/* ── Left panel ── */
.lp{width:210px;flex-shrink:0;background:var(--s-white);border-right:1px solid var(--b-xlight);display:flex;flex-direction:column}
.lp-hd{flex-shrink:0;padding:9px 14px 8px;border-bottom:1px solid var(--b-xlight);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.65px;color:var(--t-subtle);display:flex;align-items:center;justify-content:space-between}
.lp-hd-x{width:20px;height:20px;border:none;background:transparent;color:var(--t-subtle);font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;border-radius:3px;transition:background .12s}
.lp-hd-x:hover{background:var(--i-hover);color:var(--t-primary)}
.lp-body{padding:14px;display:flex;flex-direction:column;gap:13px;flex:1;overflow-y:auto}

.fld{display:flex;flex-direction:column;gap:4px}
.fld-lbl{font-size:12px;font-weight:600;color:var(--t-primary);display:flex;align-items:center;gap:4px}
.fld-i{width:14px;height:14px;border:1.5px solid var(--b-light);border-radius:50%;font-size:9px;font-style:normal;color:var(--t-subtle);display:inline-flex;align-items:center;justify-content:center;cursor:help;flex-shrink:0}
.f-in{height:30px;width:100%;border:1px solid var(--b-default);border-radius:var(--r);padding:0 8px;font-family:var(--font);font-size:13px;color:var(--t-primary);background:var(--s-white);outline:none;transition:border-color .15s,box-shadow .15s}
.f-in:focus{border-color:var(--i-active);box-shadow:0 0 0 2px var(--i-focus)}

/* Formula display */
.expr-wrap{border:1px solid var(--b-light);border-radius:var(--r);background:var(--s-surface);overflow:hidden}
.expr-disp{padding:7px 8px;font-family:'Courier New',monospace;font-size:12px;color:var(--teal);word-break:break-all;white-space:pre-wrap;line-height:1.6;min-height:40px;cursor:text}
.expr-disp.empty{color:var(--t-subtle);font-style:italic;font-family:var(--font);font-size:12px;white-space:normal}
.expr-foot{display:flex;border-top:1px solid var(--b-xlight);background:var(--s-white)}
.expr-del,.expr-clr{flex:1;height:26px;border:none;background:transparent;font-size:11px;font-weight:600;font-family:var(--font);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:3px;transition:background .12s}
.expr-del{color:var(--t-secondary);border-right:1px solid var(--b-xlight)}
.expr-del:hover{background:var(--i-hover)}
.expr-clr{color:var(--k-del-txt)}
.expr-clr:hover{background:#fff5f5}

/* Keypad toggle button */
.kp-btn{height:30px;padding:0 10px;border:1px solid var(--b-default);border-radius:var(--r);background:var(--s-surface);color:var(--t-primary);font-size:12px;font-weight:600;font-family:var(--font);cursor:pointer;display:flex;align-items:center;gap:6px;align-self:flex-start;transition:background .12s,border-color .12s,color .12s}
.kp-btn:hover{background:var(--i-hover)}
.kp-btn.open{background:var(--teal);border-color:var(--teal);color:#fff}

.lp-actions{display:flex;gap:6px}
.btn-save{height:30px;padding:0 16px;background:var(--teal);color:#fff;border:none;border-radius:var(--r);font-size:13px;font-weight:600;font-family:var(--font);cursor:pointer;transition:background .12s}
.btn-save:hover{background:var(--teal-hover)}
.btn-cancel{height:30px;padding:0 12px;background:transparent;color:var(--t-primary);border:1px solid var(--b-default);border-radius:var(--r);font-size:13px;font-family:var(--font);cursor:pointer;transition:background .12s}
.btn-cancel:hover{background:var(--s-surface)}

/* ── Canvas ── */
.canvas{flex:1;min-width:0;background:var(--s-surface);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;transition:padding-bottom .22s cubic-bezier(.4,0,.2,1)}
.canvas-ph{text-align:center;user-select:none;pointer-events:none}
.canvas-ph svg{opacity:.3;margin-bottom:12px}
.canvas-ph p{font-size:12px;color:var(--t-subtle)}
.canvas-ph p+p{margin-top:5px;font-size:11px}

/* ═══════════════════════════════════════════════════
   KEYPAD — fixed bottom
═══════════════════════════════════════════════════ */
.keypad{position:fixed;bottom:0;left:0;right:0;background:var(--s-white);border-top:2px solid var(--teal);box-shadow:0 -6px 28px rgba(0,0,0,.1);z-index:200;display:flex;flex-direction:column;height:320px;transform:translateY(100%);transition:transform .22s cubic-bezier(.4,0,.2,1)}
.keypad.open{transform:translateY(0)}

/* resize handle */
.kp-handle{position:absolute;top:-5px;left:50%;transform:translateX(-50%);width:48px;height:10px;cursor:ns-resize;z-index:5;display:flex;align-items:center;justify-content:center}
.kp-handle::after{content:'';display:block;width:36px;height:3px;background:rgba(255,255,255,.45);border-radius:2px}

/* Header */
.kp-hd{flex-shrink:0;height:36px;background:var(--teal);display:flex;align-items:center;padding:0 12px;gap:8px}
.kp-hd-title{flex:1;font-size:12px;font-weight:700;color:#fff;letter-spacing:.2px;display:flex;align-items:center;gap:7px}
.kp-hd-badge{background:rgba(255,255,255,.18);border-radius:3px;padding:1px 6px;font-size:10px;font-family:'Courier New',monospace;color:rgba(255,255,255,.85);letter-spacing:.5px}
.kp-x{width:26px;height:26px;flex-shrink:0;background:rgba(255,255,255,.15);border:none;border-radius:var(--r);color:#fff;font-size:15px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .12s}
.kp-x:hover{background:rgba(255,255,255,.28)}

/* Tab bar */
.kp-tabs{flex-shrink:0;display:flex;background:var(--s-white);border-bottom:1px solid var(--b-xlight);padding:0 12px;overflow-x:auto;scrollbar-width:none}
.kp-tabs::-webkit-scrollbar{display:none}
.kp-tab{height:33px;padding:0 14px;background:transparent;border:none;border-bottom:2px solid transparent;color:var(--t-subtle);font-size:12px;font-weight:600;font-family:var(--font);cursor:pointer;white-space:nowrap;flex-shrink:0;margin-bottom:-1px;transition:color .12s,border-color .12s}
.kp-tab:hover{color:var(--t-primary)}
.kp-tab.on{color:var(--teal);border-bottom-color:var(--teal)}

/* Body: keys + help */
.kp-body{flex:1;display:flex;min-height:0;overflow:hidden}

/* Keys pane */
.kp-keys{flex:1;overflow-y:auto;overflow-x:hidden;padding:0;min-width:0;border-right:1px solid var(--b-xlight)}
.kp-keys::-webkit-scrollbar{width:4px}
.kp-keys::-webkit-scrollbar-thumb{background:var(--b-light);border-radius:2px}

/* ── Section component (used in Attributes / Functions / Advanced) ── */
.sec{border-bottom:1px solid var(--b-xlight)}
.sec:last-child{border-bottom:none}
.sec-hd{display:flex;align-items:center;gap:7px;padding:7px 12px 7px 10px;cursor:pointer;user-select:none;background:var(--s-surface);border-left:3px solid transparent;transition:background .1s,border-color .1s}
.sec-hd:hover{background:var(--i-hover)}
.sec-hd.open{border-left-color:var(--teal);background:var(--s-white)}
.sec-arrow{font-size:8px;color:var(--b-light);transition:transform .18s,color .12s;line-height:1;width:10px;text-align:center}
.sec-hd.open .sec-arrow{transform:rotate(0deg);color:var(--teal)}
.sec-hd:not(.open) .sec-arrow{transform:rotate(-90deg)}
.sec-name{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.55px;color:var(--t-muted);flex:1}
.sec-hd.open .sec-name{color:var(--teal)}
.sec-count{font-size:10px;color:var(--t-subtle);background:var(--b-xlight);border-radius:9px;padding:1px 6px;font-weight:600}
.sec-body{padding:9px 10px 11px;display:flex;flex-wrap:wrap;gap:4px;background:var(--s-white)}
.sec-body.shut{display:none}

/* ══════════════════════════════════════════════════
   KEY BUTTONS — base
══════════════════════════════════════════════════ */
.k{
  min-width:36px;height:34px;padding:0 10px;
  border:1px solid var(--b-default);border-radius:var(--r);
  background:var(--s-white);color:var(--t-primary);
  font-size:13px;font-family:var(--font);font-weight:600;
  cursor:pointer;display:inline-flex;align-items:center;justify-content:center;
  white-space:nowrap;line-height:1;
  transition:background .1s,box-shadow .1s,transform .07s;
  -webkit-tap-highlight-color:transparent;
}
.k:hover{background:var(--i-hover);box-shadow:0 0 0 1px var(--i-hover-ring)}
.k:active{transform:scale(.92);background:var(--i-pressed)}
.k:focus-visible{outline:2px solid var(--i-active);outline-offset:1px}

/* ─ Variants ─ */
.k.attr{background:var(--k-attr-bg);border-color:var(--k-attr-bdr);color:var(--k-attr-txt);font-size:12px;max-width:180px;overflow:hidden;text-overflow:ellipsis}
.k.fn{color:var(--k-fn);border-color:var(--b-light);font-size:12px}
.k.del{background:var(--k-del-bg);border-color:var(--k-del-bdr);color:var(--k-del-txt)}
.k.clr{background:var(--k-clr-bg);border-color:var(--k-clr-bg);color:var(--k-clr-txt)}
.k.clr:hover{background:#a00;border-color:#a00;box-shadow:none}
.k.wide{min-width:72px}

/* ══════════════════════════════════════════════════
   MAC-STYLE CALCULATOR GRID  (Operations tab)
   Left panel: functions/advanced math  (7 cols wide)
   Right panel: numpad + operators      (4 cols wide)
   Combined via CSS grid
══════════════════════════════════════════════════ */
.calc-layout{
  display:grid;
  /* 7 function cols | divider | 3 num cols | 1 op col */
  grid-template-columns: repeat(7,1fr) 1px repeat(3,1fr) 1fr;
  grid-template-rows: repeat(5,1fr);
  gap:4px;
  padding:10px;
  background:var(--s-white);
  align-items:stretch;
}

/* divider column */
.calc-divider{
  grid-column:8;
  grid-row:1/6;
  background:var(--b-xlight);
  width:1px;
  margin:0 2px;
}

/* Calc key — fills its grid cell */
.ck{
  height:36px;
  border:1px solid var(--b-light);
  border-radius:var(--r);
  background:var(--s-surface);
  color:var(--t-primary);
  font-size:13px;font-family:var(--font);font-weight:600;
  cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  white-space:nowrap;line-height:1;
  transition:background .1s,box-shadow .1s,transform .07s;
  -webkit-tap-highlight-color:transparent;
  padding:0 4px;
}
.ck:hover{background:var(--i-hover);box-shadow:0 0 0 1px var(--b-default)}
.ck:active{transform:scale(.91);background:var(--i-pressed)}
.ck:focus-visible{outline:2px solid var(--i-active);outline-offset:1px}

/* Number keys — lighter, familiar */
.ck.num{background:var(--s-white);border-color:var(--b-default);font-size:15px;font-weight:700}
.ck.num:hover{background:var(--i-hover)}

/* Operator accent — teal like Tuva brand (instead of Mac orange) */
.ck.op-accent{background:var(--k-accent);border-color:var(--k-accent);color:var(--k-accent-txt);font-size:18px;font-weight:700}
.ck.op-accent:hover{background:var(--k-accent-h);border-color:var(--k-accent-h);box-shadow:none}

/* Function keys — blue text */
.ck.fn{color:var(--k-fn);font-size:12px;background:var(--s-surface)}

/* Operator non-accent — teal text, white bg */
.ck.op{color:var(--k-op);font-size:15px;font-weight:700;background:var(--s-white);border-color:var(--b-light)}

/* Constant keys — amber */
.ck.const{background:var(--k-const-bg);border-color:var(--k-const-bdr);color:var(--k-const-txt);font-size:15px}

/* Utility: delete / clear */
.ck.del{background:var(--k-del-bg);border-color:var(--k-del-bdr);color:var(--k-del-txt);font-size:12px}
.ck.clr{background:var(--k-clr-bg);border-color:var(--k-clr-bg);color:var(--k-clr-txt);font-size:12px}
.ck.clr:hover{background:#a00;box-shadow:none}

/* Category icon accent buttons in Functions grid */
.ck.cat-icon{
  font-size:18px;
  background:var(--k-accent);
  border-color:var(--k-accent);
  color:var(--k-accent-txt);
  cursor:default;
  letter-spacing:0;
}
.ck.cat-icon:hover{background:var(--k-accent-h);border-color:var(--k-accent-h);box-shadow:none}

/* Logic row — below the calc grid */
.logic-row{
  padding:6px 10px 10px;
  display:flex;flex-wrap:wrap;gap:4px;
  border-top:1px solid var(--b-xlight);
  background:var(--s-white);
}
.logic-label{
  width:100%;
  font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.55px;
  color:var(--t-subtle);
  margin-bottom:4px;
}

/* ══════════════════════════════════════════════════
   HELP PANEL — always visible right column
══════════════════════════════════════════════════ */
.kp-help{
  width:238px;flex-shrink:0;
  display:flex;flex-direction:column;
  background:var(--s-white);
  overflow:hidden;
}
.help-hd{
  flex-shrink:0;
  padding:9px 14px 8px;
  border-bottom:1px solid var(--b-xlight);
  font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.55px;
  color:var(--t-subtle);
  display:flex;align-items:center;gap:5px;
  background:var(--s-surface);
}
.help-hd::before{content:'';display:inline-block;width:3px;height:12px;background:var(--teal);border-radius:2px}
.help-body{
  flex:1;overflow-y:auto;padding:12px 14px;
}
.help-body::-webkit-scrollbar{width:4px}
.help-body::-webkit-scrollbar-thumb{background:var(--b-light);border-radius:2px}

/* Help states */
.h-idle{font-size:12px;color:var(--t-subtle);font-style:italic;line-height:1.6;padding-top:2px}
.h-name{font-family:'Courier New',monospace;font-size:14px;font-weight:700;color:var(--teal);margin-bottom:6px;word-break:break-all;line-height:1.4}
.h-desc{font-size:12px;color:var(--t-primary);line-height:1.65;margin-bottom:9px}
.h-lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--t-subtle);margin-bottom:3px;margin-top:2px}
.h-code{background:var(--s-surface);border:1px solid var(--b-light);border-left:3px solid var(--teal);border-radius:var(--r);padding:5px 8px;font-family:'Courier New',monospace;font-size:11px;color:var(--k-fn);margin-bottom:8px;word-break:break-all;line-height:1.6}
.h-ex{background:#f0f4ff;border:1px solid #c5d0f0;border-radius:var(--r);padding:5px 8px;font-family:'Courier New',monospace;font-size:11px;color:var(--t-primary);margin-bottom:9px;word-break:break-all;line-height:1.6}
.h-link{font-size:11px;color:var(--i-active);text-decoration:none;display:inline-flex;align-items:center;gap:4px}
.h-link:hover{text-decoration:underline}

/* ═══════════════ RESPONSIVE ═══════════════ */
@media(max-width:960px){
  /* Collapse help on smaller screens but keep it visible via click */
  .kp-help{width:200px}
}
@media(max-width:800px){
  .kp-help{display:none}
  .kp-keys{border-right:none}
}
@media(max-width:768px){
  .lp{display:none}
  .fbar{display:flex}
