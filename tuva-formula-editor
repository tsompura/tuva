  {l:'mod',v:' mod ',d:'Modulo — remainder.',s:'a mod b',e:'10 mod 3 → 1'},
  {l:'n!',v:'!',d:'Factorial.',s:'n!',e:'5! → 120'},
  {l:'1',v:'1',d:'',s:'',e:''},{l:'2',v:'2',d:'',s:'',e:''},{l:'3',v:'3',d:'',s:'',e:''},
  {l:'4',v:'4',d:'',s:'',e:''},{l:'5',v:'5',d:'',s:'',e:''},{l:'6',v:'6',d:'',s:'',e:''},
  {l:'7',v:'7',d:'',s:'',e:''},{l:'8',v:'8',d:'',s:'',e:''},{l:'9',v:'9',d:'',s:'',e:''},
