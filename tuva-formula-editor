function renderAdv(list) {
  const el = document.getElementById('advResults');
  el.innerHTML = '';
  list.forEach(item => {
    const b = document.createElement('button');
    b.className = 'k fn';
    b.textContent = item.l;
    b.onclick = () => ins(item.v);
    if (item.d) b.onmouseenter = () => hlp(item.l, item.d, item.s, item.e);
    el.appendChild(b);
  });
}
renderAdv(ADV);

function filterAdv(q) {
  const t = q.trim().toLowerCase();
  renderAdv(t ? ADV.filter(i => i.l.toLowerCase().includes(t) || i.d.toLowerCase().includes(t)) : ADV);
}

/* ── Drag-to-resize ── */
(function () {
  const handle = document.getElementById('kpHandle');
  const kp     = document.getElementById('keypad');
  const cv     = document.getElementById('canvas');
  let dragging = false, startY = 0, startH = 0;
  const MIN = 190, MAX = () => window.innerHeight - 80;

  function move(e) {
    if (!dragging) return;
    const y  = e.touches ? e.touches[0].clientY : e.clientY;
    const nH = Math.min(MAX(), Math.max(MIN, startH + (startY - y)));
    kp.style.height = nH + 'px';
    if (kpOpen) cv.style.paddingBottom = nH + 'px';
  }
  function up() { dragging = false; document.body.style.userSelect = ''; }

  handle.addEventListener('mousedown', e => {
    dragging = true; startY = e.clientY; startH = kp.offsetHeight;
    document.body.style.userSelect = 'none'; e.preventDefault();
  });
  handle.addEventListener('touchstart', e => {
    dragging = true; startY = e.touches[0].clientY; startH = kp.offsetHeight;
    e.preventDefault();
  }, { passive: false });

  document.addEventListener('mousemove', move);
  document.addEventListener('touchmove', move, { passive: false });
  document.addEventListener('mouseup', up);
  document.addEventListener('touchend', up);
})();
</script>
