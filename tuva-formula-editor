<!-- ═══════════════════════════════════════════════════
   FORMULA KEYPAD — fixed bottom
═══════════════════════════════════════════════════ -->
<div class="keypad" id="keypad">
  <div class="kp-handle" id="kpHandle"></div>

  <div class="kp-hd">
    <div class="kp-hd-title">
      <span>⌨</span> Formula Keypad
      <span class="kp-hd-badge">fx</span>
    </div>
    <button class="kp-x" onclick="toggleKp()" aria-label="Close">✕</button>
  </div>

  <div class="kp-tabs" role="tablist">
    <button class="kp-tab on"  onclick="sw('attributes',this)" role="tab">Attributes</button>
    <button class="kp-tab"     onclick="sw('operations',this)"  role="tab">Operations</button>
    <button class="kp-tab"     onclick="sw('functions',this)"   role="tab">Functions</button>
    <button class="kp-tab"     onclick="sw('advanced',this)"    role="tab">Advanced</button>
  </div>

  <div class="kp-body">
    <div class="kp-keys" id="keysPane">


      <!-- ═══════════════════════════════════
           TAB: ATTRIBUTES
      ═══════════════════════════════════ -->
      <div id="tab-attributes">

        <div class="sec">
          <div class="sec-hd open" onclick="togSec(this,'sa-attrs')">
            <span class="sec-arrow">▼</span>
            <span class="sec-name">Dataset Attributes</span>
            <span class="sec-count">7</span>
          </div>
