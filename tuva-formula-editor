            <button class="k attr" onclick="ins('Species')"     onmouseenter="hlp('Species','Text — species name for each case.','','concat(Species, &quot; (bird)&quot;)')">Species</button>
            <button class="k attr" onclick="ins('Body_Weight')" onmouseenter="hlp('Body_Weight','Numeric — body weight in grams.','','Body_Weight × 0.035')">Body Weight (g)</button>
            <button class="k attr" onclick="ins('Wing_Length')" onmouseenter="hlp('Wing_Length','Numeric — wing length in millimeters.','','Wing_Length ÷ Body_Length')">Wing Length (mm)</button>
            <button class="k attr" onclick="ins('Wing_Width')"  onmouseenter="hlp('Wing_Width','Numeric — wing width in millimeters.','','Wing_Width ÷ Wing_Length')">Wing Width (mm)</button>
            <button class="k attr" onclick="ins('Body_Length')" onmouseenter="hlp('Body_Length','Numeric — body length in millimeters.','','Body_Length − 10')">Body Length (mm)</button>
          </div>
        </div>

        <div class="sec">
          <div class="sec-hd open" onclick="togSec(this,'sa-qops')">
            <span class="sec-arrow">▼</span>
            <span class="sec-name">Quick Operators</span>
          </div>
          <div class="sec-body" id="sa-qops">
            <button class="k op" style="color:var(--k-op);font-size:17px;font-weight:700;border-color:var(--b-light)" onclick="ins(' + ')" onmouseenter="hlp('+','Addition.','a + b','Body_Weight + 5')">+</button>
            <button class="k op" style="color:var(--k-op);font-size:17px;font-weight:700;border-color:var(--b-light)" onclick="ins(' − ')" onmouseenter="hlp('−','Subtraction.','a − b','Wing_Length − 2')">−</button>
            <button class="k op" style="color:var(--k-op);font-size:17px;font-weight:700;border-color:var(--b-light)" onclick="ins(' × ')" onmouseenter="hlp('×','Multiplication.','a × b','Body_Weight × 2.2')">×</button>
            <button class="k op" style="color:var(--k-op);font-size:17px;font-weight:700;border-color:var(--b-light)" onclick="ins(' ÷ ')" onmouseenter="hlp('÷','Division.','a ÷ b','Wing_Length ÷ 10')">÷</button>
            <button class="k op" style="color:var(--k-op);font-size:17px;font-weight:700;border-color:var(--b-light)" onclick="ins('(')"   onmouseenter="hlp('(','Open parenthesis — groups expressions.','(a + b) × c','(Wing_Length + 2) × 3')">(</button>
            <button class="k op" style="color:var(--k-op);font-size:17px;font-weight:700;border-color:var(--b-light)" onclick="ins(')')"   onmouseenter="hlp(')','Close parenthesis.','(a + b) × c','(Wing_Length + 2) × 3')">)</button>
            <button class="k del wide" onclick="delChar()">⌫ Delete</button>
            <button class="k clr wide" onclick="clearAll()">AC Clear</button>
          </div>
        </div>

      </div>


      <!-- ═══════════════════════════════════════════════
           TAB: OPERATIONS
           Mac-style calculator layout — NO collapsible sections,
           everything in one compact grid.
           Left 7 cols: fn keys (advanced math + logic)
           Right 4 cols: numpad + operator accents
      ═══════════════════════════════════════════════ -->
      <div id="tab-operations" style="display:none">

        <!--
          Grid layout:
          Columns 1-7: function/math keys
          Column 8: invisible divider
          Columns 9-11: number pad (3 wide)
          Column 12: operator accent (1 wide)
          5 rows
        -->
        <div class="calc-layout" id="calcGrid">

          <!-- ROW 1: Grouping & advanced -->
          <button class="ck op"   data-v="("    onmouseenter="hlp('(','Open parenthesis — groups parts of a formula.','(a + b) × c','(Wing_Length + 2) × 3')"   onclick="ins('(')">(</button>
          <button class="ck op"   data-v=")"    onmouseenter="hlp(')','Close parenthesis — closes a grouped expression.',')','(Wing_Length + 2) × 3')"         onclick="ins(')')">)</button>
          <button class="ck op"   data-v=","    onmouseenter="hlp(',','Argument separator — used between function inputs.',',','mean(Body_Weight)')"             onclick="ins(', ')">,</button>
          <button class="ck fn"   data-v="abs"  onmouseenter="hlp('abs(x)','Absolute value — removes the sign.','abs(x)','abs(Body_Weight − 10)')"              onclick="ins('abs(')">abs</button>
          <button class="ck fn"   data-v="mod"  onmouseenter="hlp('mod','Modulo — the remainder after dividing a by b.','a mod b','10 mod 3 → 1')"              onclick="ins(' mod ')">mod</button>
          <button class="ck fn"   data-v="n!"   onmouseenter="hlp('n!','Factorial — product of all integers from 1 to n.','n!','5! → 120')"                     onclick="ins('!')">n!</button>
          <button class="ck del"  onmouseenter="hlp('⌫','Delete — removes the last character or token from the formula.','-','-')" onclick="delChar()">⌫</button>

          <div class="calc-divider"></div>

          <button class="ck num" onclick="ins('7')" onmouseenter="hlp('7','Digit 7.','-','-')">7</button>
          <button class="ck num" onclick="ins('8')" onmouseenter="hlp('8','Digit 8.','-','-')">8</button>
          <button class="ck num" onclick="ins('9')" onmouseenter="hlp('9','Digit 9.','-','-')">9</button>
          <button class="ck op-accent" onmouseenter="hlp('÷','Division — divides a by b.','a ÷ b','Wing_Length ÷ 100')" onclick="ins(' ÷ ')">÷</button>

          <!-- ROW 2: Powers & roots -->
          <button class="ck fn"   data-v="x²"   onmouseenter="hlp('x²','Squares a value — same as x^2.','x^2','Body_Weight^2')"                                 onclick="ins('^2')">x²</button>
          <button class="ck fn"   data-v="x³"   onmouseenter="hlp('x³','Cubes a value — same as x^3.','x^3','Wing_Length^3')"                                   onclick="ins('^3')">x³</button>
          <button class="ck fn"   data-v="xⁿ"   onmouseenter="hlp('x^n','Raises x to any power n.','x^n','Body_Weight^2')"                                      onclick="ins('^')">x<sup>n</sup></button>
          <button class="ck fn"   data-v="√"    onmouseenter="hlp('√(x)','Square root of x.','√(x)','√(Body_Weight)')"                                          onclick="ins('√(')">√</button>
          <button class="ck fn"   data-v="ⁿ√"   onmouseenter="hlp('n√(n, x)','Nth root — e.g. cube root is n√(3, x).','n√(n, x)','n√(3, Body_Weight)')"         onclick="ins('n√(')">ⁿ√</button>
          <button class="ck fn"   data-v="round" onmouseenter="hlp('round(x)','Rounds x to the nearest whole number.','round(x)','round(3.7) → 4')"              onclick="ins('round(')">round</button>
          <button class="ck clr"  onmouseenter="hlp('AC','All Clear — removes the entire formula.','-','-')" onclick="clearAll()">AC</button>

          <div class="calc-divider"></div>

          <button class="ck num" onclick="ins('4')" onmouseenter="hlp('4','Digit 4.','-','-')">4</button>
          <button class="ck num" onclick="ins('5')" onmouseenter="hlp('5','Digit 5.','-','-')">5</button>
          <button class="ck num" onclick="ins('6')" onmouseenter="hlp('6','Digit 6.','-','-')">6</button>
          <button class="ck op-accent" onmouseenter="hlp('×','Multiplication — multiplies a by b.','a × b','Body_Weight × 2.2')" onclick="ins(' × ')">×</button>

          <!-- ROW 3: Log/trig -->
          <button class="ck fn"   data-v="log10" onmouseenter="hlp('log10(x)','Base-10 logarithm of x.','log10(x)','log10(100) → 2')"                           onclick="ins('log10(')">log₁₀</button>
          <button class="ck fn"   data-v="ln"    onmouseenter="hlp('ln(x)','Natural log (base e) of x.','ln(x)','ln(1) → 0')"                                   onclick="ins('ln(')">ln</button>
          <button class="ck fn"   data-v="sin"   onmouseenter="hlp('sin(angle)','Sine of angle (radians).','sin(angle)','sin(π ÷ 2) → 1')"                       onclick="ins('sin(')">sin</button>
          <button class="ck fn"   data-v="cos"   onmouseenter="hlp('cos(angle)','Cosine of angle (radians).','cos(angle)','cos(0) → 1')"                         onclick="ins('cos(')">cos</button>
          <button class="ck fn"   data-v="tan"   onmouseenter="hlp('tan(angle)','Tangent of angle (radians).','tan(angle)','tan(π ÷ 4) → 1')"                    onclick="ins('tan(')">tan</button>
          <button class="ck const" data-v="π"   onmouseenter="hlp('π','Pi — ratio of a circle\'s circumference to its diameter. ≈ 3.14159…','π','2 × π × r')"   onclick="ins('π')">π</button>
          <button class="ck const" data-v="e"   onmouseenter="hlp('e','Euler\'s number — base of the natural logarithm. ≈ 2.71828…','e','e^2 ≈ 7.389')"          onclick="ins('e')">e</button>

          <div class="calc-divider"></div>

          <button class="ck num" onclick="ins('1')" onmouseenter="hlp('1','Digit 1.','-','-')">1</button>
          <button class="ck num" onclick="ins('2')" onmouseenter="hlp('2','Digit 2.','-','-')">2</button>
          <button class="ck num" onclick="ins('3')" onmouseenter="hlp('3','Digit 3.','-','-')">3</button>
          <button class="ck op-accent" onmouseenter="hlp('−','Subtraction — subtracts b from a.','a − b','Wing_Length − 2')" onclick="ins(' − ')">−</button>

          <!-- ROW 4: Logic conditionals -->
          <button class="ck fn"   data-v="if"   onmouseenter="hlp('if(condition, trueValue, falseValue)','Returns trueValue when condition is true, falseValue otherwise.','if(condition, trueValue, falseValue)','if(Body_Weight &gt; 10, &quot;Heavy&quot;, &quot;Light&quot;)')" onclick="ins('if(')">if</button>
          <button class="ck fn"   data-v="and"  onmouseenter="hlp('and','True when both A and B are true.','A and B','Body_Weight &gt; 5 and Gender == &quot;F&quot;')"                onclick="ins(' and ')">and</button>
          <button class="ck fn"   data-v="or"   onmouseenter="hlp('or','True when at least one of A or B is true.','A or B','Species == &quot;Hawk&quot; or Body_Weight &gt; 20')"     onclick="ins(' or ')">or</button>
          <button class="ck fn"   data-v="xor"  onmouseenter="hlp('xor','True when exactly one condition is true, not both.','A xor B','(x &gt; 0) xor (y &gt; 0)')"                   onclick="ins(' xor ')">xor</button>
          <button class="ck fn"   data-v="=="   onmouseenter="hlp('==','Equal to comparison.','a == b','Species == &quot;Hawk&quot;')"                                                  onclick="ins(' == ')">==</button>
          <button class="ck fn"   data-v="!="   onmouseenter="hlp('!=','Not equal to comparison.','a != b','Gender != &quot;M&quot;')"                                                  onclick="ins(' != ')">!=</button>
          <button class="ck fn"   data-v="random" onmouseenter="hlp('random()','Returns a random decimal between 0 and 1.','random()','random() × 100')"                               onclick="ins('random()')">rand</button>

          <div class="calc-divider"></div>

          <button class="ck num" onclick="ins('0')" style="grid-column:span 2" onmouseenter="hlp('0','Digit 0.','-','-')">0</button>
          <button class="ck num" onclick="ins('.')" onmouseenter="hlp('.','Decimal point.','-','3.14')">.</button>
          <button class="ck op-accent" onmouseenter="hlp('+','Addition — adds a and b together.','a + b','Body_Weight + 5')" onclick="ins(' + ')">+</button>

          <!-- ROW 5: Comparisons + random -->
          <button class="ck fn"   onmouseenter="hlp('&lt;','Less than comparison.','a &lt; b','Body_Weight &lt; 15')"   onclick="ins(' &lt; ')">&lt;</button>
          <button class="ck fn"   onmouseenter="hlp('&lt;=','Less than or equal.','a &lt;= b','Body_Weight &lt;= 10')" onclick="ins(' &lt;= ')">&lt;=</button>
          <button class="ck fn"   onmouseenter="hlp('&gt;','Greater than comparison.','a &gt; b','Body_Weight &gt; 10')" onclick="ins(' > ')">&gt;</button>
          <button class="ck fn"   onmouseenter="hlp('&gt;=','Greater than or equal.','a &gt;= b','Body_Weight &gt;= 5')" onclick="ins(' >= ')">&gt;=</button>
          <button class="ck fn"   onmouseenter="hlp('randomInt(min, max)','Random whole number between min and max.','randomInt(min, max)','randomInt(1, 6)')" onclick="ins('randomInt(min, max)')">rInt</button>
          <button class="ck fn"   onmouseenter="hlp('pickRandom(attribute)','Picks a random value from the attribute.','pickRandom(attribute)','pickRandom(Species)')" onclick="ins('pickRandom(')">pick</button>
          <button class="ck fn"   onmouseenter="hlp('abs(x)','Absolute value.','abs(x)','abs(−5) → 5')" onclick="ins('abs(')">|x|</button>

          <div class="calc-divider"></div>

          <!-- equal / apply — spans full height of last row -->
          <button class="ck op-accent" style="grid-column:9/13" onmouseenter="hlp('Apply Formula','Click to confirm and apply the formula to your attribute.','-','-')" onclick="applyFormula()">Apply Formula</button>

        </div>
        <!-- /calc-layout -->

      </div><!-- /tab-operations -->


      <!-- ═══════════════════════════════════════════════════
           TAB: FUNCTIONS — Mac-style calculator grid layout
           Left 7 cols: Statistics (10) + Trig (3)
           Divider
           Right 4 cols: Date & Time (6) + Text (5)
           Accent column: teal
      ═══════════════════════════════════════════════════ -->
      <div id="tab-functions" style="display:none">

        <!--
          Grid: 7 fn cols | 1px divider | 3 wide fn cols | 1 accent col
          5 rows — matches Operations layout exactly
        -->
        <div class="calc-layout">

          <!-- ── ROW 1: Statistics top row + Date/Time top ── -->

          <!-- left: stats -->
          <button class="ck fn" onmouseenter="hlp('mean(attribute)','Arithmetic mean — the average of all values in the attribute.','mean(attribute)','mean(Body_Weight) → e.g. 12.4')" onclick="ins('mean(')">mean</button>
          <button class="ck fn" onmouseenter="hlp('median(attribute)','The middle value when all values are sorted from low to high.','median(attribute)','median(Body_Weight)')" onclick="ins('median(')">median</button>
          <button class="ck fn" onmouseenter="hlp('min(attribute)','The smallest value in the attribute.','min(attribute)','min(Wing_Length)')" onclick="ins('min(')">min</button>
          <button class="ck fn" onmouseenter="hlp('max(attribute)','The largest value in the attribute.','max(attribute)','max(Wing_Length)')" onclick="ins('max(')">max</button>
          <button class="ck fn" onmouseenter="hlp('sum(attribute)','Adds up all values in the attribute.','sum(attribute)','sum(Body_Weight)')" onclick="ins('sum(')">sum</button>
          <button class="ck fn" onmouseenter="hlp('count(attribute)','Number of non-empty values in the attribute.','count(attribute)','count(Species)')" onclick="ins('count(')">count</button>
          <button class="ck del" onmouseenter="hlp('⌫','Delete — removes the last character or token.','-','-')" onclick="delChar()">⌫</button>

          <div class="calc-divider"></div>

          <!-- right: date/time — wider labels, 3 cols + accent -->
          <button class="ck fn" style="grid-column:span 3;font-size:11px" onmouseenter="hlp('secondsToMS(s)','Converts a number of seconds into milliseconds.','secondsToMS(s)','secondsToMS(60) → 60000')" onclick="ins('secondsToMS(')">secondsToMS</button>
          <button class="ck op-accent" style="grid-row:span 2" onmouseenter="hlp('Date &amp; Time','Convert time values to milliseconds for calculations. Useful when working with date-based attributes.','-','-')">⏱</button>

          <!-- ── ROW 2: Stats row 2 + Date/Time row 2 ── -->

          <button class="ck fn" onmouseenter="hlp('iqr(attribute)','Interquartile range — the spread of the middle 50% of values (Q3 − Q1).','iqr(attribute)','iqr(Body_Weight)')" onclick="ins('iqr(')">iqr</button>
          <button class="ck fn" onmouseenter="hlp('stdDev(attribute)','Standard deviation — measures how spread out values are from the mean.','stdDev(attribute)','stdDev(Wing_Length)')" onclick="ins('stdDev(')">stdDev</button>
          <button class="ck fn" onmouseenter="hlp('variance(attribute)','Statistical variance — the square of the standard deviation.','variance(attribute)','variance(Body_Weight)')" onclick="ins('variance(')">variance</button>
          <button class="ck fn" onmouseenter="hlp('meanAvDev(attribute)','Mean absolute deviation — average distance of each value from the mean.','meanAvDev(attribute)','meanAvDev(Body_Weight)')" onclick="ins('meanAvDev(')">mADev</button>
          <button class="ck fn" onmouseenter="hlp('sin(angle)','Sine of an angle. Must be in radians, not degrees.','sin(angle)','sin(π ÷ 2) → 1')" onclick="ins('sin(')">sin</button>
          <button class="ck fn" onmouseenter="hlp('cos(angle)','Cosine of an angle. Must be in radians.','cos(angle)','cos(0) → 1')" onclick="ins('cos(')">cos</button>
          <button class="ck fn" onmouseenter="hlp('tan(angle)','Tangent of an angle. Must be in radians.','tan(angle)','tan(π ÷ 4) → 1')" onclick="ins('tan(')">tan</button>

          <div class="calc-divider"></div>

          <button class="ck fn" style="grid-column:span 3;font-size:11px" onmouseenter="hlp('minutesToMS(m)','Converts a number of minutes into milliseconds.','minutesToMS(m)','minutesToMS(5)')" onclick="ins('minutesToMS(')">minutesToMS</button>
          <!-- accent already spans rows 1–2 -->

          <!-- ── ROW 3: Text functions top + Date/Time row 3 ── -->

          <button class="ck fn" onmouseenter="hlp('concat(a, b)','Joins two or more text values together into one string.','concat(a, b)','concat(Species, &quot; — &quot;, Gender)')" onclick="ins('concat(')">concat</button>
          <button class="ck fn" onmouseenter="hlp('extract(text, start, end)','Extracts characters between the start and end positions.','extract(text, start, end)','extract(Species, 1, 3)')" onclick="ins('extract(')">extract</button>
