  {l:')',v:')',d:'Close parenthesis.',s:'(a + b) × c',e:'(Wing_Length + 2) × 3'},
  {l:',',v:', ',d:'Argument separator.',s:'fn(a, b)',e:'mean(Body_Weight)'},
  {l:'abs',v:'abs(',d:'Absolute value.',s:'abs(x)',e:'abs(Body_Weight − 10)'},
